# Native Render BACKEND settings. Documentation template, not a secret store.
# Set these in Render's service configuration. Node does not auto-load this file.
NODE_VERSION=24.21.0
NODE_ENV=production
SCOPEWISE_MODE=production
SCOPEWISE_HOST=0.0.0.0
SCOPEWISE_WORK_DIR=/opt/render/project/src/work
# Replace with the ONE stable HTTPS Vercel frontend origin, no path/query.
SCOPEWISE_PUBLIC_ORIGIN=https://scopewise.example.com
# Render supplies PORT (normally 10000) and RENDER_EXTERNAL_URL automatically.
# For a different native host, set SCOPEWISE_PORT and SCOPEWISE_BACKEND_ORIGIN.
# SCOPEWISE_PORT=10000
# SCOPEWISE_BACKEND_ORIGIN=https://scopewise-api.onrender.com
# SECRET VALUES ARE OMITTED. The Blueprint generates two independent secrets:
# SCOPEWISE_SESSION_SECRET: backend only, at least 32 random bytes.
# SCOPEWISE_PROXY_SECRET: copy the same private value to Vercel Production env.
# Do not put either value in this file, Git, browser code, or diagnostic logs.
# Alternate session file mode (instead of managed session-secret env):
# SCOPEWISE_SESSION_SECRET_FILE=/opt/render/project/src/work/secrets/session-secret
# A Unix secret file must be owner-private (0600), with private parent dirs.
# Do not configure both session-secret sources. Proxy secret stays managed env.
# Do not grant production secrets to untrusted preview builds/deployments.
